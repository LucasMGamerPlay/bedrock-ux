{
	"schemaVersion": 1,
	"id": "bedrockux",
	"version": "${version}",
	"name": "Bedrock UX",
	"description": "Bedrock Edition's GUI/UX on Java Edition. Client-side. / Paridade visual da GUI/UX do Minecraft Bedrock para a Java Edition. Mod client-side.",
	"authors": [
		"Lucas"
	],
	"license": "MIT",
	"icon": "assets/bedrockux/icon.png",
	"contact": {
		"homepage": "https://github.com/LucasMGamerPlay/bedrock-ux",
		"sources": "https://github.com/LucasMGamerPlay/bedrock-ux",
		"issues": "https://github.com/LucasMGamerPlay/bedrock-ux/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.bedrockux.BedrockUXClient"
		]
	},
	"mixins": [
		{
			"config": "bedrockux.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {},
	"custom": {
		"modmenu": {
			"badges": [
				"client"
			]
		}
	}
}
